# ==============================================================================
# NetFusion Configuration Environment Template
# ==============================================================================

# Operation Mode: 'demo' (zero AWS/hardware dependency) or 'production' (live Boto3, Docker, WG)
NETFUSION_MODE=demo

# Backend Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=netfusion-super-secret-jwt-signing-key-change-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection (PostgreSQL)
POSTGRES_USER=netfusion
POSTGRES_PASSWORD=netfusion_secure_password_2026
POSTGRES_DB=netfusion_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://netfusion:netfusion_secure_password_2026@postgres:5432/netfusion_db

# Frontend Settings
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:8000/api/v1

# Hybrid WireGuard VPN Configuration
WG_INTERFACE=wg0
WG_PORT=51820
WG_ONPREM_TUNNEL_IP=10.50.0.1/30
WG_AWS_TUNNEL_IP=10.50.0.2/30
ONPREM_NETWORK_CIDR=10.10.0.0/16
AWS_VPC_CIDR=10.20.0.0/16

# AWS Credentials (Optional in 'demo' mode; required for live cloud operations)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_SESSION_TOKEN=

# Cybersecurity & Suricata Settings
SURICATA_EVE_PATH=/var/log/suricata/eve.json
SECURITY_COLLECTOR_INTERVAL_SEC=2

# Observability
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# AI Assistant Settings
AI_DIAGNOSTICS_ENABLED=true
AI_MODEL=default
